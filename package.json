{
    "name": "omom-pre-orders",
    "version": "1.0.0",
    "scripts": {
        "build": "wp-scripts build && npx tailwindcss -i ./assets/css/src/omom-admin.css -o ./assets/css/dist/omom-admin.css --minify",
        "start": "concurrently \"wp-scripts start\" \"npm run tailwind:watch\"",
        "tailwind:watch": "npx tailwindcss -i ./assets/css/src/omom-admin.css -o ./assets/css/dist/omom-admin.css --watch",
        "watch": "concurrently \"wp-scripts start --hot\" \"npm run tailwind:watch\""
    },
    "author": "",
    "license": "UNLICENSED",
    "repository": {},
    "private": true,
    "devDependencies": {
        "@types/jquery": "^3.5.32",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@wordpress/scripts": "^30.3.0",
        "autoprefixer": "^10.4.21",
        "concurrently": "^9.1.2",
        "css-loader": "^7.1.2",
        "jquery": "^3.7.1",
        "postcss": "^8.5.3",
        "postcss-loader": "^8.1.1",
        "select2": "^4.1.0-rc.0",
        "source-map-loader": "^5.0.0",
        "style-loader": "^4.0.0",
        "tailwindcss": "^3.4.17",
        "ts-loader": "^9.5.1",
        "typescript": "~5.7.2",
        "watch": "^1.0.2",
        "webpack": "^5.95.0",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "@tailwindcss/postcss": "^4.0.14",
        "@woocommerce/components": "^8.2.0",
        "@wordpress/components": "^29.5.0",
        "@wordpress/element": "^6.16.0"
    }
}
